msgid "File (%1$s) was found, but has a different size (%2$s) from what was expected (%3$s) - it may be corrupt."
msgstr "파일(%1$s)이(가) 있지만 예상 크기(%2$s)와 다른 크기(%3$s)가 있습니다 - 파일이 손상되었을 수 있습니다."

#. translators: %s: Web server name
#: admin.php:1520
