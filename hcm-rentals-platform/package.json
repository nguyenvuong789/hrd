{
  "name": "hcm-owner-rentals",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "check": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply hcm-owner-rentals --local",
    "seed:export": "node scripts/export-legacy-seed.mjs",
